{"version":9,"id":"18deb661292fa3b8","title":"The Lighthouse Atlas","blocks":[{"Paragraph":{"chars":{"runs":[{"text":"THE LIGHTHOUSE ATLAS  /  CHAPTER ONE","style":{"font":"Noto Sans","size":9.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[35,101,162],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Sans","size":9.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[35,101,162],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"The blue hour","style":{"font":"Noto Serif","size":28.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":28.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":1,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":18.0,"list":"None","checked":false,"keep_next":true,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"By the time the ferry reached the island, the sea had turned the colour of ink. Mara stood at the rail with her grandfather’s atlas pressed beneath her coat. Every harbour in the book had a name. This one had only a small blue circle, drawn in a hand she knew better than her own.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"On the quay, a bicycle leaned against a stack of empty lobster pots. Beyond it, white houses climbed the hill towards a lighthouse that had not shone for twenty years. A woman in a yellow raincoat raised one hand, as if she had been expecting this particular ferry all her life.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"“You brought the book,” she said. It was a statement, not a question. Mara looked down at the atlas. A narrow ribbon of blue light had appeared between its pages.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"They walked uphill without speaking. Behind them the ferry sounded its horn, a long, low note that seemed to travel through the stones beneath their feet. At the last bend, Mara turned to look at the harbour. The blue circle on the map was glowing.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"For the first time since opening her grandfather’s letter, she felt that she was moving towards something, rather than away.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}}],"page":{"paper":"A4","landscape":false,"margins":[72.0,72.0,72.0,72.0],"color":[255,255,255],"page_numbers":true,"columns":1,"column_gap":18.0,"header":{"chars":{"runs":[]},"style":{"font":"Noto Sans","size":9.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[95,95,95],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.0,"before":0.0,"after":0.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]},"footer":{"chars":{"runs":[]},"style":{"font":"Noto Sans","size":9.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[95,95,95],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.0,"before":0.0,"after":0.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},"starred":false,"tabs":[{"id":"section-0","title":"01 · The blue hour","blocks":[]},{"id":"section-1","title":"02 · A map of small things","blocks":[{"Paragraph":{"chars":{"runs":[{"text":"THE LIGHTHOUSE ATLAS  /  CHAPTER TWO","style":{"font":"Noto Sans","size":9.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[35,101,162],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Sans","size":9.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[35,101,162],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"A map of small things","style":{"font":"Noto Serif","size":28.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":28.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":1,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":18.0,"list":"None","checked":false,"keep_next":true,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"The keeper’s kitchen smelled of orange peel and rain. On the table lay a map of the island, its coastline stitched in blue thread. Someone had marked the position of every bench, every spring and every place where the wind changed direction.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"“A useful map remembers what people forget,” the woman said, setting two cups beside the atlas. “The large things can look after themselves.”","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"Mara opened the book to the harbour. Where the blue circle had been, a tiny drawing of the kitchen now appeared. Two cups. An open window. A girl who had finally arrived.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}}]},{"id":"section-2","title":"03 · The light returns","blocks":[{"Paragraph":{"chars":{"runs":[{"text":"THE LIGHTHOUSE ATLAS  /  CHAPTER THREE","style":{"font":"Noto Sans","size":9.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[35,101,162],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Sans","size":9.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[35,101,162],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"The light returns","style":{"font":"Noto Serif","size":28.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":28.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":1,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":18.0,"list":"None","checked":false,"keep_next":true,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"At dusk they carried the atlas up the spiral stair. The lantern room was cold, but the glass held the last of the sun. Mara placed the book on the brass stand and watched its pages turn in a wind she could not feel.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"Far below, the first windows of the village began to shine. Then the lighthouse answered: a single blue beam sweeping across the sea, drawing a new line on a very old map.","style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":11.5,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.4,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}}]},{"id":"section-3","title":"Characters & notes","blocks":[{"Paragraph":{"chars":{"runs":[{"text":"Between the chapters","style":{"font":"Noto Serif","size":24.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Serif","size":24.0,"bold":true,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":1,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":18.0,"list":"None","checked":false,"keep_next":true,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"Mara — a cartographer discovering the places her grandfather left behind.","style":{"font":"Noto Sans","size":11.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Sans","size":11.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"The keeper — a patient guardian of the island’s smallest stories.","style":{"font":"Noto Sans","size":11.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Sans","size":11.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}},{"Paragraph":{"chars":{"runs":[{"text":"The atlas — a map that changes when someone pays attention.","style":{"font":"Noto Sans","size":11.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"}}]},"style":{"font":"Noto Sans","size":11.0,"bold":false,"italic":false,"underline":false,"strike":false,"color":[33,48,65],"highlight":null,"link":null,"baseline":"Normal"},"heading":0,"alignment":"Left","indent":0.0,"first_indent":0.0,"line_spacing":1.35,"before":0.0,"after":10.0,"list":"None","checked":false,"keep_next":false,"page_break_before":false,"keep_together":false,"widow_control":true,"annotations":[]}}]}],"active_tab":0}